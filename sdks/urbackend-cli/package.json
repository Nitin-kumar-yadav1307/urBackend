{
  "name": "@urbackend/cli",
  "version": "0.1.0",
  "description": "Official CLI for urBackend",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ub": "./bin/ub.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "urbackend",
    "cli",
    "baas"
  ],
  "author": "urBackend Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/geturbackend/urBackend",
    "directory": "sdks/urbackend-cli"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "ora": "^9.0.0"
  }
}