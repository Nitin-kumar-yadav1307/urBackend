---
import BaseLayout from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowLeft, Home } from 'lucide-react';
---

<BaseLayout title="404 Page Not Found - urBackend" description="The page you are looking for does not exist on urBackend.">
  <Navbar />
  
  <main class="error-page-container">
    <!-- Glowing background elements -->
    <div class="radial-glow glow-1"></div>
    <div class="radial-glow glow-2"></div>
    
    <div class="error-content">
      <div class="error-code">404</div>
      <div class="error-title">Endpoint Not Found</div>
      <p class="error-message">
        It looks like the resource you are trying to query does not exist or has been deleted from our database.
      </p>
      
      <div class="error-actions">
        <a href="/" class="btn-primary-glow">
          <Home size={16} />
          <span>Back to Home</span>
        </a>
        <button onclick="window.history.back()" class="btn-secondary-glow">
          <ArrowLeft size={16} />
          <span>Go Back</span>
        </button>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .error-page-container {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background-color: #030303;
    padding: 2rem;
  }

  .radial-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
  }

  .glow-1 {
    background: radial-gradient(circle, #00f5d4 0%, transparent 70%);
    top: 10%;
    left: 20%;
  }

  .glow-2 {
    background: radial-gradient(circle, #3ecf8e 0%, transparent 70%);
    bottom: 10%;
    right: 20%;
  }

  .error-content {
    text-align: center;
    max-width: 500px;
    z-index: 1;
    animation: fadeIn 0.8s ease-out;
  }

  .error-code {
    font-size: 8rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, #3ecf8e 0%, #00f5d4 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
    font-family: 'JetBrains Mono', monospace;
    letter-spacing: -0.05em;
  }

  .error-title {
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .error-message {
    font-size: 1.1rem;
    color: #a1a1aa;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }

  .btn-primary-glow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #3ecf8e 0%, #00f5d4 100%);
    color: #030303;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    border: none;
    box-shadow: 0 0 20px rgba(0, 245, 212, 0.2);
  }

  .btn-primary-glow:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 30px rgba(0, 245, 212, 0.4);
  }

  .btn-secondary-glow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    color: #fff;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.95rem;
    transition: all 0.2s ease;
    border: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }

  .btn-secondary-glow:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .error-code {
      font-size: 6rem;
    }
    .error-title {
      font-size: 1.6rem;
    }
    .error-actions {
      flex-direction: column;
      width: 100%;
    }
    .btn-primary-glow, .btn-secondary-glow {
      width: 100%;
      justify-content: center;
    }
  }
</style>
