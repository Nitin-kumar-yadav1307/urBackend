# ─────────────────────────────────────────────────────────────────────────────
# Python Microservice — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Must match the INTERNAL_SECRET in the root Dashboard API .env
INTERNAL_SECRET=generate_a_random_32_char_secret_here

# Must match INTERNAL_PAYLOAD_KEY in Dashboard API .env
# Used for decrypting BYOK keys in transit (AES-256-GCM)
INTERNAL_PAYLOAD_KEY=generate_a_64_char_hex_string_here

# ── AI APIs ──────────────────────────────────────────────────────────────────
# Required for AI Query Builder
GROQ_API_KEY=gsk_your_groq_api_key_here
